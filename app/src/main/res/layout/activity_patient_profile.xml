<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#74B3CE"
        android:orientation="vertical"
        android:padding="18dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_back"
            android:layout_gravity="start"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvProfileAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="?"
            android:textColor="#74B3CE"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT PROFILE"
                android:textSize="11sp"
                android:textColor="#4A8BA8"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Username" android:textSize="12sp" android:textColor="#888888"
                android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etUsername"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Phone number" android:textSize="12sp" android:textColor="#888888"
                android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etPhone"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:padding="12dp" android:inputType="phone"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="City" android:textSize="12sp" android:textColor="#888888"
                android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etCity"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Date of birth" android:textSize="12sp" android:textColor="#888888"
                android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etDob"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Blood type" android:textSize="12sp" android:textColor="#888888"
                android:layout_marginBottom="4dp"/>
            <EditText android:id="@+id/etBlood"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:padding="12dp" android:background="@drawable/input_bg"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save changes"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_green"/>
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🚪 Logout"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#FFE4E4"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>