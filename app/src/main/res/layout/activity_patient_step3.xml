<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Green header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#74B3CE"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient registration"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 3 of 3 — Medical and account"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Progress bar — all active -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_active" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_active" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/step_active" />

        </LinearLayout>

    </LinearLayout>

    <!-- Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEDICAL PROFILE"
                android:textSize="11sp"
                android:textColor="#000"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blood type"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerBlood"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etConditions"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Known allergies or conditions (optional)"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                android:textSize="11sp"
                android:textColor="#000"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Password"
                android:padding="12dp"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Confirm password"
                android:padding="12dp"
                android:inputType="textPassword"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="← Back"
            android:textColor="#1D9E75"
            android:background="@drawable/btn_outline"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Create account"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>