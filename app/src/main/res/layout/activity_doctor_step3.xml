<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#74B3CE"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor registration"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 3 of 4 — Clinic info"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <View android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/step_active" />
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#FFFFFF" />
            <View android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/step_active" />
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#FFFFFF" />
            <View android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/step_active"/>
            <View android:layout_width="0dp" android:layout_height="2dp"
                android:layout_weight="1" android:background="#FFFFFF" />
            <View android:layout_width="24dp" android:layout_height="24dp"
                android:background="@drawable/step_inactive" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLINIC / PRACTICE"
                android:textSize="11sp"
                android:textColor="#4A8BA8"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etClinic"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Clinic or hospital name"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Address"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="City"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABILITY"
                android:textSize="11sp"
                android:textColor="#4A8BA8"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etStartTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Start time (e.g. 09:00)"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="End time (e.g. 17:00)"
                android:padding="12dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appointment slot duration"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerSlot"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_bg"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="← Back"
            android:textColor="#74B3CE"
            android:background="@drawable/btn_outline"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Next →"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_green"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>