<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#74B3CE"
        android:orientation="vertical"
        android:padding="18dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_back"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book appointment"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a date and time slot"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Doctor card -->
            <LinearLayout
                android:id="@+id/docCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_card"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_margin="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDocInitials"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_doc_avatar"
                    android:gravity="center"
                    android:text=".?"
                    android:textColor="#74B3CE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDocName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doctor name"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#222222"/>

                    <TextView
                        android:id="@+id/tvDocSpec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Specialization"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvDocFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fee"
                        android:textSize="12sp"
                        android:textColor="#74B3CE"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Calendar section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a date"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_doc_card"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="14dp">

                <!-- Calendar header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <Button
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="‹"
                        android:textSize="18sp"
                        android:textColor="#74B3CE"
                        android:background="@null"
                        android:padding="0dp"/>

                    <TextView
                        android:id="@+id/tvMonth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="April 2026"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>

                    <Button
                        android:id="@+id/btnNextMonth"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="›"
                        android:textSize="18sp"
                        android:textColor="#74B3CE"
                        android:background="@null"
                        android:padding="0dp"/>

                </LinearLayout>

                <!-- Day names row -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:padding="8dp"
                    android:id="@+id/dayNamesGrid"/>

                <!-- Calendar days -->
                <GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:padding="8dp"/>

            </LinearLayout>

            <!-- Time slots -->
            <TextView
                android:id="@+id/tvSlotsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available time slots"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="14dp"/>

            <!-- Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note for the doctor (optional)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Describe your symptoms or reason for visit..."
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:background="@drawable/bg_doc_card"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Select a date and time slot"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_green"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="24dp"
                android:enabled="false"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>